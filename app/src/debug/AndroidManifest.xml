<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets CI install a locally built on-device AI pack (see DebugPackReceiver). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="atom.app.ondevice.DebugPackReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="atom.app.debug.INSTALL_PACK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
