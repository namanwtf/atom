<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only (src/debug is not part of the release variant): the hook the end-to-end task tests drive over
  adb. See docs/TESTING.md and tools/e2e/run.py. CI checks that the release APK never contains it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exported so `adb shell content ...` reaches it; the provider itself answers only the shell and root uids. -->
        <provider
            android:name="atom.app.e2e.E2eProvider"
            android:authorities="${applicationId}.e2e"
            android:exported="true" />
    </application>
</manifest>
