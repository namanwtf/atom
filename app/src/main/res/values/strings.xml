    <!-- Setup -->
    <string name="setup_welcome_title">Welcome to Atom</string>
    <string name="setup_welcome_text">A few permissions and Atom can work your phone for you.</string>
    <string name="setup_accessibility_title">Accessibility</string>
    <string name="setup_accessibility_text">Lets Atom read what is on screen and tap, type and scroll for you. It is only active while a task runs.</string>
    <string name="setup_open_accessibility">Open Accessibility settings</string>
    <string name="setup_notifications_title">Notifications</string>
    <string name="setup_notifications_text">Shows progress with a Stop button, and asks for approval while Atom works in other apps.</string>
    <string name="setup_allow_notifications">Allow notifications</string>
    <string name="setup_shell_title">Shell access</string>
    <string name="setup_battery_title">Battery</string>
    <string name="setup_battery_1">Atom does nothing in the background. It runs only while a task you started is in progress, and the notification disappears when it ends.</string>
    <string name="setup_battery_2">On-device models are unloaded from memory after 5 minutes idle, or sooner if the system needs the memory.</string>
    <string name="setup_battery_3">When the phone is hot or the battery is low, on-device inference pauses and your cloud fallback (if set) takes over.</string>
    <string name="setup_battery_4">The screen is never kept awake. A short CPU wake lock is held only if a task is still running with the screen off.</string>
