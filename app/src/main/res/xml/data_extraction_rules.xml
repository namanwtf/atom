<?xml version="1.0" encoding="utf-8"?>
<!--
  No cloud backup and no device-to-device transfer: API keys are sealed with a Keystore key that never leaves this
  phone, and conversations are private. Settings > Data backup is the only way to move data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
