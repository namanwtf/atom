<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Scheduled tasks and timed automations: one exact alarm for the earliest wake-up, re-armed after boot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The listening service for automation triggers Android only delivers to running apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Wi-Fi triggers and the Wi-Fi name condition. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Bluetooth device triggers. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Location triggers: coarse proximity alerts held by the system; background access so they fire while closed. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application>
        <receiver
            android:name="atom.automation.system.AlarmReceiver"
            android:exported="false" />

        <!-- Switched off at run time while no automation exists (AutomationRuntime.syncSystemEvents), so boot and
             clock changes never start Atom for nothing. -->
        <receiver
            android:name="atom.automation.system.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Disabled until an automation uses a Bluetooth trigger, so connections never wake Atom otherwise. -->
        <receiver
            android:name="atom.automation.system.BluetoothReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="atom.automation.system.PlaceReceiver"
            android:exported="false" />

        <receiver
            android:name="atom.automation.system.ActionReceiver"
            android:exported="false" />

        <!-- Runs only while an enabled automation needs a runtime-only broadcast; registers receivers, nothing else. -->
        <service
            android:name="atom.automation.system.TriggerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-defined device automations waiting for system events" />
        </service>
    </application>
</manifest>
