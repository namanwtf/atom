    <!-- Linux home -->
    <string name="linux_title">Linux</string>
    <string name="linux_intro">A real Linux system on your phone with a package manager and tools. Nothing runs in the background: it starts with a terminal or command and stops when they end.</string>
    <string name="linux_status">Status</string>
    <string name="linux_not_installed">Not installed</string>
    <string name="linux_distribution">Distribution</string>
    <string name="linux_alpine_body">Alpine: musl and busybox, tiny and fast (about 4 MB). Packages with apk.</string>
    <string name="linux_debian_body">Debian Trixie: glibc, the broadest compatibility (about 90 MB). Packages with apt.</string>
    <string name="linux_mode">Execution mode</string>
    <string name="linux_mode_standard">Standard</string>
    <string name="linux_mode_root">Root</string>
    <string name="linux_mode_standard_body">PRoot, no root needed. Private to Atom.</string>
    <string name="linux_mode_root_body">chroot in its own mount namespace: native speed. Needs root.</string>
    <string name="linux_root_lost">Root access is gone. Your Linux files are kept. Switch to Standard to keep using them, or restore root.</string>
    <string name="linux_use_standard">Use Standard (PRoot)</string>
