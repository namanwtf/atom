<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Floating bubble, mini chat, run capsule and edge glow. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <!-- Not a foreground service: a visible overlay already keeps the process perceptible. It only exists while
             the bubble is switched on, so the system can bring the bubble back after a low-memory kill. -->
        <service
            android:name="atom.overlay.bubble.BubbleService"
            android:exported="false" />
    </application>
</manifest>
