<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Fallback stage for the background display's live view when Atom may not draw over other apps. -->
        <activity
            android:name="atom.vdisplay.viewfinder.StageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="atom.vdisplay.stage"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
