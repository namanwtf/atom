<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Opt-in "Hey Atom" (tier 2) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Cloud speech services (recognition and spoken answers). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chat answers keep being read aloud in the background, only while speaking. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <!-- Find the device's real speech recognizer (Android 11+ package visibility). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- System "Digital assistant app" picker for AssistantRole.requestIntent(). -->
        <intent>
            <action android:name="android.settings.VOICE_INPUT_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_DEFAULT_APPS_SETTINGS" />
        </intent>
        <!-- System text-to-speech engines (fallback voice). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application>

        <service
            android:name="atom.voice.service.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Exists only while a chat answer is being read aloud; stops itself when speaking ends. -->
        <service
            android:name="atom.voice.tts.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Tier 1: system digital assistant (no mic, no background work). -->
        <service
            android:name="atom.voice.assist.AtomVoiceInteractionService"
            android:exported="true"
            android:label="@string/atom_voice_assistant_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/atom_voice_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name="atom.voice.assist.AtomVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required by VoiceInteractionServiceInfo for the role to be grantable; passes through to the real recognizer.
             Exported like every RecognitionService; the framework base class enforces RECORD_AUDIO on each caller. -->
        <service
            android:name="atom.voice.assist.AtomRecognitionService"
            android:exported="true"
            tools:ignore="ExportedService"
            android:label="@string/atom_voice_assistant_label">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>
