<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Shares generated images and agent files out of the app. Read-only, granted per share. -->
        <provider
            android:name="atom.web.files.WebFileProvider"
            android:authorities="${applicationId}.web.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
