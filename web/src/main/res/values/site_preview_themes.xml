<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Themes for the site preview's WebView only. A WebView reports the page's prefers-color-scheme from its context
      theme's isLightTheme, so the preview wraps its context in the one matching Atom's own dark or light look.
    -->
    <style name="AtomSitePreviewLight" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
    </style>
    <style name="AtomSitePreviewDark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
